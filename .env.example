# News aggregator configuration and API keys

# News API key (from https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# World News API key (from https://worldnewsapi.com/)
WORLD_NEWS_API_KEY=your_world_news_api_key_here

# Tavily API key (from https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Gemini API key (optional, for LLM-based industry tagging and ranking)
GEMINI_API_KEY=your_gemini_api_key_here
